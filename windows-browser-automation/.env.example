# Bu dosyayi .env olarak kopyalayin ve doldurun. .env ASLA git'e girmez.

# GitHub (gh CLI kuruluysa gerekmez; REST fallback icin)
GITHUB_TOKEN=

# X (Twitter) - OAuth2 user context; scope: bookmark.read tweet.read users.read offline.access
# Maliyet uyarisi: owned-read cagrilari kayit basina ucretlendirilir (~$0.001/kayit, Nisan 2026)
X_CLIENT_ID=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_USER_ID=

# LinkedIn - OAuth2 user context; scope: openid profile w_member_social
# (developer.linkedin.com -> "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=

# Canva Connect API
CANVA_ACCESS_TOKEN=

# Supabase (service role key YALNIZCA sunucu tarafinda kalir; asla tarayiciya/loga koymayin)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Gmail OAuth dosya yollari (varsayilanlar genellikle yeterli)
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# Depolar
AUDIT_DIR=audit
STORE_DB=data/results.db
